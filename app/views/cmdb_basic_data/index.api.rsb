# Purpose: REST API template rendering a paginated collection of location hierarchy levels
#          as JSON or XML. Single level serialisation is shared with show.api.rsb via CmdbHelper.
api.array :hrzcm_locat_hiers, api_meta(:total_count => @hierarchies_count, :offset => @offset, :limit => @limit) do
  @hierarchies.each do |hierarchy|
    render_api_locat_hier(hierarchy, api)
  end
end
