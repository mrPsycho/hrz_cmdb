# Purpose: REST API template rendering a paginated collection of external systems as JSON or XML.
#          Serialisation of a single external system is shared with show_ext_sys.api.rsb via CmdbHelper.
api.array :hrzcm_ext_systems, api_meta(:total_count => @ext_systems_count, :offset => @offset, :limit => @limit) do
  @ext_systems.each do |ext_sys|
    render_api_ext_sys(ext_sys, api)
  end
end
