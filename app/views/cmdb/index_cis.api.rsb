# Purpose: REST API template rendering a paginated collection of configuration items as JSON or XML.
#          Linked issues are omitted here to avoid one extra query per CI, use show_ci for them.
api.array :hrzcm_cis, api_meta(:total_count => @cis_count, :offset => @offset, :limit => @limit) do
  @cis.each do |ci|
    render_api_ci(ci, api)
  end
end
