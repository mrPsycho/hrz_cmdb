# Purpose: REST API template rendering a paginated collection of CI classes as JSON or XML.
#          Serialisation of a single CI class is shared with show_ci_class.api.rsb via CmdbHelper.
api.array :hrzcm_ci_classes, api_meta(:total_count => @ci_classes_count, :offset => @offset, :limit => @limit) do
  @ci_classes.each do |ci_class|
    render_api_ci_class(ci_class, api)
  end
end
