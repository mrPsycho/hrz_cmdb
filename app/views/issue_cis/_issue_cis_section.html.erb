<%# Purpose: Partial injected into issue pages to display associated CIs.
            Shows CI list in issue view with add/remove functionality when CMDB module is enabled.
            The table skeleton (thead + tbody#ci-rows) is always rendered and only hidden while no CI
            is linked, so issue_cis.js never has to build the (translated) column headers itself.
            Translated messages for issue_cis.js are passed in the data-ci-messages attribute. %>

<%# Load the CIs once with their associations to avoid one query per row and column. %>
<% issue_cis = @issue.project.module_enabled?(:cmdb) ?
                 @issue.cis.includes(:ci_class, :location, :lifecycle_status, :assigned_user).to_a : [] %>
<% if @issue.project.module_enabled?(:cmdb) && (issue_cis.any? || @issue.editable?) %>
  <%# Messages shown by issue_cis.js; it has no access to the Redmine translations itself. %>
  <% ci_messages = {
       load_failed: l(:error_ci_load_failed),
       add_failed: l(:error_ci_add_failed),
       add_request_failed: l(:error_ci_add_request_failed),
       remove_failed: l(:error_ci_remove_failed),
       remove_request_failed: l(:error_ci_remove_request_failed)
     } %>
  <div id="issue-cis-section" class="issue-cis-section" data-issue-id="<%= @issue.id %>"
       data-ci-messages="<%= ci_messages.to_json %>">
    <hr>
    <div class="contextual">
      <% if @issue.editable? %>
        <%= link_to l(:label_add_ci),
                    '#',
                    class: 'icon icon-add',
                    id: 'add-ci-link',
                    onclick: 'IssueCis.openModal(); return false;' %>
      <% end %>
    </div>

    <h3><%= l(:label_configuration_items) %></h3>

    <div id="issue-cis-list">
      <%# Always rendered; hidden while empty and shown by issue_cis.js when the first CI is added.
          The columns must match the cells of _ci_row.html.erb. %>
      <table class="list issue-cis-table"<%= raw(' style="display: none;"') if issue_cis.empty? %>>
        <thead>
          <tr>
            <th><%= l(:field_name) %></th>
            <th><%= l(:label_ci_class) %></th>
            <th><%= l(:label_location) %></th>
            <th><%= l(:label_lifecycle_status) %></th>
            <th><%= l('hrz_cmdb.fields.j_assigned_user') %></th>
            <% if @issue.editable? %>
              <th style="width: 15%;"></th>
            <% end %>
          </tr>
        </thead>
        <tbody id="ci-rows">
          <% issue_cis.each do |ci| %>
            <%= render partial: 'issue_cis/ci_row', locals: { ci: ci, issue: @issue } %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- CI Selection Modal -->
  <%= render partial: 'issue_cis/ci_selection_modal' %>
<% end %>
